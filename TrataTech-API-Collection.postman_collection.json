{
  "info": {
    "name": "TrataTech Smart Contract API",
    "description": "Complete API collection for TrataTech smart contract system including admin, auth, business, ownership, product passport, and provenance endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "your-api-key-here",
      "type": "string"
    },
    {
      "key": "walletAddress",
      "value": "0x1234567890123456789012345678901234567890",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "description": "API key management and authentication endpoints",
      "item": [
        {
          "name": "Generate API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"walletAddress\": \"{{walletAddress}}\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/generate-api-key",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "generate-api-key"]
            }
          }
        },
        {
          "name": "Validate API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiKey\": \"{{apiKey}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/validate-api-key",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "validate-api-key"]
            }
          }
        },
        {
          "name": "Revoke API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiKey\": \"{{apiKey}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/revoke-api-key",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "revoke-api-key"]
            }
          }
        },
        {
          "name": "List API Keys",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/list-api-keys",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "list-api-keys"]
            }
          }
        }
      ]
    },
