{
  "name": "tratatech-api-server",
  "version": "1.0.0",
  "description": "Express TypeScript API server for TrataTech smart contracts with MongoDB and IPFS integration",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon",
    "dev:build": "nodemon --exec \"npm run build && node dist/server.js\"",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "setup": "node scripts/setup-networks.js",
    "deploy:amoy": "NETWORK=polygon-amoy npx hardhat run scripts/deploy-polygon.js --network polygon-amoy",
    "deploy:mainnet": "NETWORK=polygon-mainnet npx hardhat run scripts/deploy-polygon.js --network polygon-mainnet",
    "update-env": "node scripts/update-env-addresses.js",
    "compile": "npx hardhat compile",
    "verify:amoy": "npx hardhat verify --network polygon-amoy",
    "verify:mainnet": "npx hardhat verify --network polygon-mainnet"
  },
  "keywords": [
    "tratatech",
    "blockchain",
    "api",
    "express",
    "typescript",
    "mongodb",
    "ipfs"
  ],
  "author": "TrataTech Team",
  "license": "MIT",
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "@openzeppelin/contracts-upgradeable": "^5.4.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.8.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ipfs-http-client": "^60.0.1",
    "joi": "^17.11.0",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pinata": "^2.5.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.11.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.4",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.55.0",
    "hardhat": "^2.26.3",
    "hardhat-gas-reporter": "^2.3.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "solidity-coverage": "^0.8.16",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module"
}
