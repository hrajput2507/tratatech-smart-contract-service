{
  "info": {
    "name": "TrataTech Ownership API Collection",
    "description": "Complete collection of all ownership-related API endpoints for TrataTech smart contract system",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "x-api-key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{api_key}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3005/api/v1/ownership",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "admin-api-key-123",
      "type": "string"
    },
    {
      "key": "deed_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "request_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Ownership Deeds",
      "item": [
        {
          "name": "Create Ownership Deed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passportId\": 1,\n  \"ownerAddress\": \"0x1234567890123456789012345678901234567890\",\n  \"purchaseDate\": 1640995200,\n  \"purchasePrice\": \"1000000000000000000\",\n  \"ipfsData\": {\n    \"metadata\": {\n      \"name\": \"Premium Watch Ownership Deed\",\n      \"description\": \"Official ownership deed for Premium Watch #PWC001234567\",\n      \"image\": \"https://example.com/ownership-deed.jpg\",\n      \"attributes\": [\n        {\n          \"trait_type\": \"Deed Type\",\n          \"value\": \"Ownership Certificate\"\n        },\n        {\n          \"trait_type\": \"Product\",\n          \"value\": \"Premium Chronograph\"\n        },\n        {\n          \"trait_type\": \"Serial Number\",\n          \"value\": \"PWC001234567\"\n        },\n        {\n          \"trait_type\": \"Purchase Date\",\n          \"value\": \"2022-01-01\"\n        },\n        {\n          \"trait_type\": \"Purchase Price\",\n          \"value\": \"1.0 ETH\"\n        }\n      ]\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/deeds",
              "host": ["{{base_url}}"],
              "path": ["deeds"]
            },
            "description": "Create a new ownership deed for a product passport. Requires admin, operator, or transferAgent role."
          },
          "response": []
        },
        {
          "name": "Get Ownership Deed",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/deeds/{{deed_id}}",
              "host": ["{{base_url}}"],
              "path": ["deeds", "{{deed_id}}"]
            },
            "description": "Retrieve details of a specific ownership deed by ID."
          },
          "response": []
        },
        {
          "name": "Transfer Ownership Deed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newOwner\": \"0xabcdefabcdefabcdefabcdefabcdefabcdefabcd\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/deeds/{{deed_id}}/transfer",
              "host": ["{{base_url}}"],
              "path": ["deeds", "{{deed_id}}", "transfer"]
            },
            "description": "Transfer ownership of a deed to a new owner. Requires wallet address authentication."
          },
          "response": []
        },
        {
          "name": "Lock Ownership Deed",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/deeds/{{deed_id}}/lock",
              "host": ["{{base_url}}"],
              "path": ["deeds", "{{deed_id}}", "lock"]
            },
            "description": "Lock an ownership deed to prevent transfers. Requires wallet address authentication."
          },
          "response": []
        },
        {
          "name": "Unlock Ownership Deed",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/deeds/{{deed_id}}/unlock",
              "host": ["{{base_url}}"],
              "path": ["deeds", "{{deed_id}}", "unlock"]
            },
            "description": "Unlock an ownership deed to allow transfers. Requires wallet address authentication."
          },
          "response": []
        },
        {
          "name": "Set Royalty for Deed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiver\": \"0x1111111111111111111111111111111111111111\",\n  \"percentage\": 5.0\n}"
            },
            "url": {
              "raw": "{{base_url}}/deeds/{{deed_id}}/royalty",
              "host": ["{{base_url}}"],
              "path": ["deeds", "{{deed_id}}", "royalty"]
            },
            "description": "Set royalty information for an ownership deed. Requires wallet address authentication."
          },
          "response": []
        },
        {
          "name": "Disable Royalty for Deed",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/deeds/{{deed_id}}/royalty",
              "host": ["{{base_url}}"],
              "path": ["deeds", "{{deed_id}}", "royalty"]
            },
            "description": "Disable royalty for an ownership deed. Requires wallet address authentication."
          },
          "response": []
        }
      ],
      "description": "Endpoints for managing ownership deeds"
    },
    {
      "name": "Transfer Requests",
      "item": [
        {
          "name": "Create Transfer Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deedId\": 1,\n  \"requesterAddress\": \"0xabcdefabcdefabcdefabcdefabcdefabcdefabcd\",\n  \"proposedPrice\": \"1200000000000000000\",\n  \"reason\": \"Purchase offer for luxury watch collection\",\n  \"expirationDate\": 1641081600\n}"
            },
            "url": {
              "raw": "{{base_url}}/transfer-requests",
              "host": ["{{base_url}}"],
              "path": ["transfer-requests"]
            },
            "description": "Create a transfer request for an ownership deed. Requires admin, operator, or transferAgent role."
          },
          "response": []
        },
        {
          "name": "Get Transfer Request",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/transfer-requests/{{request_id}}",
              "host": ["{{base_url}}"],
              "path": ["transfer-requests", "{{request_id}}"]
            },
            "description": "Retrieve details of a specific transfer request by ID."
          },
          "response": []
        },
        {
          "name": "Approve Transfer Request",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/transfer-requests/{{request_id}}/approve",
              "host": ["{{base_url}}"],
              "path": ["transfer-requests", "{{request_id}}", "approve"]
            },
            "description": "Approve a transfer request. Requires wallet address authentication and deed ownership."
          },
          "response": []
        },
        {
          "name": "Reject Transfer Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Price too low for this luxury item\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/transfer-requests/{{request_id}}/reject",
              "host": ["{{base_url}}"],
              "path": ["transfer-requests", "{{request_id}}", "reject"]
            },
            "description": "Reject a transfer request with a reason. Requires wallet address authentication and deed ownership."
          },
          "response": []
        },
        {
          "name": "Execute Transfer Request",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/transfer-requests/{{request_id}}/execute",
              "host": ["{{base_url}}"],
              "path": ["transfer-requests", "{{request_id}}", "execute"]
            },
            "description": "Execute an approved transfer request. Requires wallet address authentication and requester verification."
          },
          "response": []
        }
      ],
      "description": "Endpoints for managing transfer requests"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set default API key if not already set",
          "if (!pm.collectionVariables.get('api_key')) {",
          "    pm.collectionVariables.set('api_key', 'admin-api-key-123');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Log response for debugging",
          "console.log('Response Status:', pm.response.status);",
          "console.log('Response Body:', pm.response.text());",
          "",
          "// Extract deed_id from create deed response",
          "if (pm.response.code === 201 && pm.request.url.path.includes('deeds') && pm.request.method === 'POST') {",
          "    try {",
          "        const responseJson = pm.response.json();",
          "        if (responseJson.data && responseJson.data.deedData) {",
          "            // You might want to extract the actual deed ID from the response",
          "            console.log('Deed created successfully');",
          "        }",
          "    } catch (e) {",
          "        console.log('Could not parse response JSON');",
          "    }",
          "}",
          "",
          "// Extract request_id from create transfer request response",
          "if (pm.response.code === 201 && pm.request.url.path.includes('transfer-requests') && pm.request.method === 'POST') {",
          "    try {",
          "        const responseJson = pm.response.json();",
          "        if (responseJson.data && responseJson.data.requestData) {",
          "            // You might want to extract the actual request ID from the response",
          "            console.log('Transfer request created successfully');",
          "        }",
          "    } catch (e) {",
          "        console.log('Could not parse response JSON');",
          "    }",
          "}"
        ]
      }
    }
  ]
}
