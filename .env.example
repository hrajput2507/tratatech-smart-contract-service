# ============================================
# TrataTech Platform Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ============================================
# NETWORK CONFIGURATION
# ============================================

# Ethereum Mainnet
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
# or Alchemy: https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Ethereum Testnets
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
GOERLI_RPC_URL=https://eth-goerli.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Polygon
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
MUMBAI_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ============================================
# WALLET CONFIGURATION
# ============================================

# Deployer wallet private key (without 0x prefix)
# NEVER share this key or commit it to version control
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Deployer address (for reference/validation)
DEPLOYER_ADDRESS=0x...

# Multi-signature wallet addresses (optional but recommended)
ADMIN_ADDRESS=0x...
MULTISIG_ADDRESS=0x...

# ============================================
# GASLESS TRANSACTION CONFIGURATION
# ============================================

# Relayer wallet that pays gas for users
# This wallet needs to be funded with ETH
RELAYER_PRIVATE_KEY=your_relayer_private_key_without_0x_prefix
RELAYER_ADDRESS=0x...

# Trusted Forwarder Contract Address
# Deploy once and share across all contracts
# Leave empty for first deployment, then update after forwarder is deployed
FORWARDER_ADDRESS=

# Relayer Service Configuration
RELAYER_MIN_BALANCE=1.0  # Minimum ETH balance in relayer wallet
RELAYER_REFILL_AMOUNT=5.0  # ETH to add when refilling
RELAYER_CHECK_INTERVAL=60  # Minutes between balance checks

# ============================================
# CONTRACT CONFIGURATION
# ============================================

# Platform Fee Configuration (in basis points)
PLATFORM_FEE=250  # 2.5% = 250 basis points
MIN_PLATFORM_FEE=0  # Minimum fee (0%)
MAX_PLATFORM_FEE=1000  # Maximum fee (10%)

# Timelock Configuration
TIMELOCK_DELAY=172800  # 2 days in seconds

# Rate Limiting
RATE_LIMIT_DURATION=60  # Seconds between actions
DAILY_ACTION_LIMIT=100  # Max actions per day per user

# Treasury and Fee Collection
TREASURY_ADDRESS=0x...
FEE_COLLECTOR_ADDRESS=0x...

# ============================================
# BLOCKCHAIN EXPLORER API KEYS
# ============================================

# For contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
BASESCAN_API_KEY=your_basescan_api_key

# ============================================
# GAS CONFIGURATION
# ============================================

# Gas Reporter (for testing)
REPORT_GAS=true
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_for_usd_prices

# Gas Settings
GAS_LIMIT=30000000  # Block gas limit for tests
GAS_PRICE=auto  # Use 'auto' or specify in gwei (e.g., "30")

# ============================================
# TESTING CONFIGURATION
# ============================================

# Test Settings
TEST_TIMEOUT=120000  # Test timeout in milliseconds
FORK_ENABLED=false  # Enable mainnet forking for tests
FORK_BLOCK_NUMBER=  # Specific block to fork from

# ============================================
# DEPLOYMENT ADDRESSES (Updated after deployment)
# ============================================

# Core Contracts
MAIN_CONTRACT_ADDRESS=
PRODUCT_PASSPORT_ADDRESS=
OWNERSHIP_REGISTRY_ADDRESS=
PROVENANCE_ADDRESS=
UPGRADEABLE_PASSPORT_ADDRESS=
SECURITY_LIBRARY_ADDRESS=

# ============================================
# IPFS CONFIGURATION (Optional)
# ============================================

# For metadata storage
IPFS_API_URL=https://ipfs.infura.io:5001/api/v0
IPFS_GATEWAY_URL=https://gateway.ipfs.io/ipfs/
IPFS_PROJECT_ID=your_ipfs_project_id
IPFS_PROJECT_SECRET=your_ipfs_project_secret

# ============================================
# MONITORING & ALERTS (Optional)
# ============================================

# Discord Webhook for alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Email alerts (using SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
ALERT_EMAIL_TO=admin@example.com
ALERT_EMAIL_FROM=alerts@yourplatform.com

# Monitoring Service
ALCHEMY_NOTIFY_WEBHOOK=https://alchemy.com/notify/...
TENDERLY_PROJECT=your_tenderly_project
TENDERLY_USERNAME=your_tenderly_username

# ============================================
# BACKEND SERVICE CONFIGURATION
# ============================================

# API Configuration
API_PORT=3000
API_HOST=localhost
API_KEY=your_secure_api_key_for_backend_services

# Database (for transaction history)
DATABASE_URL=postgresql://user:password@localhost:5432/tratatech

# Redis (for caching/queue)
REDIS_URL=redis://localhost:6379

# ============================================
# SECURITY CONFIGURATION
# ============================================

# Signature Verification
SIGNING_DOMAIN=TrataTech
SIGNING_VERSION=1

# Rate Limiting for API
API_RATE_LIMIT_WINDOW=900000  # 15 minutes in ms
API_RATE_LIMIT_MAX=100  # Max requests per window

# ============================================
# ENVIRONMENT SETTINGS
# ============================================

# Development, Staging, or Production
NODE_ENV=development

# Network to deploy to (mainnet, sepolia, goerli, polygon, mumbai, localhost)
NETWORK=localhost

# Debug mode
DEBUG=false
VERBOSE_LOGGING=false

# ============================================
# EXAMPLE VALUES FOR LOCAL DEVELOPMENT
# ============================================
# These are Hardhat's default test accounts - NEVER use in production!

# Example Private Keys (Hardhat Test Accounts)
# Account #0: 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# PRIVATE_KEY=ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Account #1: 0x70997970C51812dc3A010C7d01b50e0d17dc79C8  
# RELAYER_PRIVATE_KEY=59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# ============================================
# NOTES
# ============================================
# 1. Never commit your actual .env file to git
# 2. Keep private keys secure - use hardware wallets for production
# 3. Fund the relayer wallet before running gasless transactions
# 4. Deploy forwarder first, then update FORWARDER_ADDRESS
# 5. Consider using different wallets for different networks
# 6. Monitor relayer balance to ensure uninterrupted service
# 7. Use environment-specific .env files (.env.local, .env.staging, .env.production)
# ============================================

