            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rolex Watch\",\n  \"description\": \"Luxury watch manufacturer\",\n  \"website\": \"https://rolex.com\",\n  \"authorizedCountries\": [\"US\", \"CA\", \"EU\"],\n  \"ipfsData\": {\n    \"metadata\": {\n      \"name\": \"Rolex Brand Registration\",\n      \"description\": \"Official brand registration for Rolex watches\",\n      \"image\": \"https://example.com/rolex-logo.png\",\n      \"attributes\": [\n        {\n          \"trait_type\": \"Brand Type\",\n          \"value\": \"Luxury Watches\"\n        },\n        {\n          \"trait_type\": \"Established\",\n          \"value\": \"1905\"\n        }\n      ]\n    }\n  }\n}"
