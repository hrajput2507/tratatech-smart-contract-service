    {
      "key": "baseUrl",
      "value": "http://localhost:3005",
      "type": "string"
    },
    {
      "key": "adminApiKey",
      "value": "admin-api-key-123",
      "type": "string"
    },
    {
      "key": "userApiKey",
      "value": "user-api-key-123",
      "type": "string"
    },
    {
      "key": "operatorApiKey",
